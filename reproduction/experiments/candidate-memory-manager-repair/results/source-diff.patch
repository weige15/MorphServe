+std::vector<TensorInfo> parse_tensor_map(const PythonTensorMap& tensor_map) {
+    std::vector<TensorInfo> result;
+    result.reserve(tensor_map.size());
+    for (const auto& tensor_entry : tensor_map) {
+        for (const auto& [name, info] : tensor_entry) {
+            result.push_back({
+                name,
+                py::cast<size_t>(info.at("offset")),
+                py::cast<std::vector<int64_t>>(info.at("shape")),
+                py::cast<c10::ScalarType>(info.at("dtype")),
+                py::cast<size_t>(info.at("size")),
+            });
+        }
+    }
+    return result;
+}
